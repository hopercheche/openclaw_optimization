# syntax=docker/dockerfile:1

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OPENCLAW_HOST=0.0.0.0 \
    OPENCLAW_PORT=8787 \
    OPENCLAW_DATA_DIR=/openclaw-runs \
    OPENCLAW_WORKSPACE=/repo \
    OPENCLAW_ENFORCE_WORKSPACE_BOUNDARY=1 \
    HOME=/tmp/openclaw

RUN groupadd --system --gid 10001 openclaw \
    && useradd --system --uid 10001 --gid 10001 --home-dir /tmp/openclaw --shell /usr/sbin/nologin openclaw

WORKDIR /repo

COPY requirements.txt /tmp/requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

COPY deploy/tcp_forward.py /opt/openclaw/tcp_forward.py
COPY deploy/https_connect_proxy.py /opt/openclaw/https_connect_proxy.py

RUN mkdir -p /openclaw-runs /workspace /tmp/openclaw /repo /opt/openclaw \
    && chown -R openclaw:openclaw /openclaw-runs /workspace /tmp/openclaw \
    && chmod 0555 /repo /opt/openclaw /opt/openclaw/tcp_forward.py /opt/openclaw/https_connect_proxy.py

USER 10001:10001

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import json, urllib.request; json.load(urllib.request.urlopen('http://127.0.0.1:8787/api/health', timeout=2))['ok']"

CMD ["python", "/repo/backend/openclaw/server.py", "--host", "0.0.0.0", "--port", "8787"]
