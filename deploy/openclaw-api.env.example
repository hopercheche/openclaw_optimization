# Copy to deploy/openclaw-api.env and fill only the provider you need.
# The secure Docker launcher reads this file but injects only an allowlist of
# OpenClaw/model-provider variables into the container.

# DeepSeek-compatible provider:
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENCLAW_DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI-compatible provider:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENCLAW_OPENAI_MODEL=gpt-4.1-mini

# DashScope OpenAI-compatible provider:
# DASHSCOPE_API_KEY=sk-...
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENCLAW_DASHSCOPE_MODEL=qwen-plus

# Shared:
# OPENCLAW_MODEL_TIMEOUT_SECONDS=45
# OPENCLAW_MODEL_MAX_TOKENS=1600
# OPENCLAW_MODEL_PLANNER_POLICY=always
# OPENCLAW_PLANNER_PROFILE_MODEL=/repo/data/planner_models/profile_policy_model.json
# OPENCLAW_TERMINAL_PLANNER_PROFILE_MODEL=/repo/data/planner_models/profile_policy_model_terminal_only_20260704.json

# Recommended planner profile preset for the 2026-07-08 packaging run:
# See deploy/openclaw-planner-safe-distill-v2.env.example
